# API Configuration
API_KEY=your_api_football_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/football_db
# For local development with SQLite (comment out above and uncomment below)
# DATABASE_URL=sqlite:///football_stats.db

# Redis Configuration (optional for caching)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Cache Configuration
CACHE_TYPE=redis
CACHE_TIMEOUT=300

# Application Settings
PORT=5000
WORKERS=4
MAX_RETRIES=3
RETRY_DELAY=1

# Logging
LOG_LEVEL=INFO

# Security (Production)
HTTPS_ONLY=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
